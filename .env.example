VITE_API_BASE_URL=http://localhost:8000
ASHES_PUBLIC_BASE_URL=http://localhost:5173
ASHES_API_BASE_URL=http://localhost:8000
ASHES_ALLOWED_ORIGINS=http://localhost:5173

# MongoDB (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ashes_ai
# Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Ashes super-admin access. Comma-separate owner/admin account emails.
ASHES_ADMIN_EMAILS=

# Menu-card AI import
ASHES_MENU_IMPORT_PROVIDER=openai
OPENAI_API_KEY=
ASHES_MENU_VISION_MODEL=gpt-5.5

# Optional command-provider fallback
# ASHES_MENU_IMPORT_COMMAND=python tools/menu_vision_runner.py
# ASHES_MENU_IMPORT_TIMEOUT=120

# Media storage: local for development, R2/S3 for production
ASHES_STORAGE_PROVIDER=local
# Cloudflare R2 / S3-compatible production example:
# ASHES_STORAGE_PROVIDER=r2
# ASHES_S3_BUCKET=ashes-media
# ASHES_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# ASHES_S3_REGION=auto
# ASHES_S3_ACCESS_KEY_ID=
# ASHES_S3_SECRET_ACCESS_KEY=
# Public custom domain or R2 public bucket URL used for images, QR files and 3D models:
# ASHES_S3_PUBLIC_BASE_URL=https://media.example.com

# Billing
# manual = create pending checkout intents without charging cards
# stripe = create real recurring Stripe Checkout subscriptions
ASHES_BILLING_PROVIDER=manual
ASHES_ALLOW_DEV_BILLING=false
# IMPORTANT: use the secret key from the Stripe account that should RECEIVE Ashes subscription payments.
# Keep these backend-only and never expose them through VITE_* variables.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Configure the Stripe webhook endpoint as:
# https://YOUR_API_DOMAIN/api/billing/stripe/webhook
# Admin can edit currency and Starter/Pro monthly prices from /admin.

# Production web/API example
# ASHES_PUBLIC_BASE_URL=https://app.example.com
# ASHES_API_BASE_URL=https://api.example.com
# ASHES_ALLOWED_ORIGINS=https://app.example.com
# ASHES_ADMIN_EMAILS=owner@example.com
# ASHES_BILLING_PROVIDER=stripe
