# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Public application URLs
ASHES_PUBLIC_BASE_URL=http://localhost:5173
ASHES_API_BASE_URL=http://localhost:8000
ASHES_ALLOWED_ORIGINS=http://localhost:5173

# Database — never commit a real URI or password
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ashes_ai

# Access control
ASHES_ADMIN_EMAILS=admin@example.com

# Optional AI menu import
ASHES_MENU_IMPORT_PROVIDER=disabled
GEMINI_API_KEY=
ASHES_GEMINI_VISION_MODEL=gemini-3-flash-preview
XAI_API_KEY=
ASHES_XAI_VISION_MODEL=grok-4.6
OPENAI_API_KEY=
ASHES_MENU_VISION_MODEL=

# GPU worker: disposable compute only. The API uploads one product image, waits for
# TRELLIS to create the GLB, then persists that GLB through the storage backend.
ASHES_TRELLIS_WORKER_URL=
ASHES_TRELLIS_WORKER_TOKEN=
ASHES_3D_TIMEOUT=900
ASHES_3D_POLL_SECONDS=2
ASHES_3D_HTTP_TIMEOUT=30

# Storage. Keep `local` for development. Switch to `s3` (or r2) in production.
ASHES_STORAGE_PROVIDER=local
ASHES_S3_BUCKET=
ASHES_S3_REGION=us-east-1
ASHES_S3_ENDPOINT_URL=
ASHES_S3_PUBLIC_BASE_URL=
ASHES_S3_ACCESS_KEY_ID=
ASHES_S3_SECRET_ACCESS_KEY=

# Billing
ASHES_BILLING_PROVIDER=manual
ASHES_ALLOW_DEV_BILLING=false
