# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Public application URLs
ASHES_PUBLIC_BASE_URL=http://localhost:5173
ASHES_API_BASE_URL=http://localhost:8000
ASHES_ALLOWED_ORIGINS=http://localhost:5173

# Database — never commit a real URI or password
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ashes_ai

# Access control
ASHES_ADMIN_EMAILS=admin@example.com

# Optional AI menu import
ASHES_MENU_IMPORT_PROVIDER=disabled
OPENAI_API_KEY=
ASHES_MENU_VISION_MODEL=

# GPU worker: creates 4 consistent views, runs TRELLIS, returns a public GLB.
ASHES_TRELLIS_WORKER_URL=
ASHES_TRELLIS_WORKER_TOKEN=

# Local development storage and billing
ASHES_STORAGE_PROVIDER=local
ASHES_BILLING_PROVIDER=manual
ASHES_ALLOW_DEV_BILLING=false
